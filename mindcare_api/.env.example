# ─── DATABASE (PostgreSQL) ─────────────────────────────────────────────────
# Формат: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg2://postgres:yourpassword@localhost:5432/mindcare

# ─── TEST DATABASE (изолированные integration-тесты) ───────────────────────
# Отдельный PostgreSQL ТОЛЬКО для тестов. Integration-тесты НЕ работают с dev-БД:
# scripts/isolated_test_db.py создаёт одноразовую mindcare_test_<random>, применяет
# Alembic, гоняет pytest и удаляет БД в finally.
# database-компонента здесь = admin-точка 'postgres' (runner создаёт дочернюю БД сам).
# Пользователю нужна привилегия CREATEDB (ALTER USER <user> CREATEDB;).
# ENV=test выставляют test.ps1 / test.sh — менять ENV в .env не нужно.
# Реальный пароль НЕ коммитить.
TEST_DATABASE_URL=postgresql+psycopg2://postgres:yourpassword@localhost:5432/postgres

# ─── AUTH ─────────────────────────────────────────────────────────────────
SESSION_EXPIRE_DAYS=7

# ─── EMAIL ────────────────────────────────────────────────────────────────
# EMAIL_MODE=dev   → OTP выводится в консоль, письма не отправляются
# EMAIL_MODE=smtp  → реальная отправка через SMTP
EMAIL_MODE=dev

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com

# SMTP transport security:
# - For port 587 use SMTP_TLS=true  and SMTP_SSL=false  (STARTTLS, default).
# - For port 465 use SMTP_TLS=false and SMTP_SSL=true   (implicit SSL).
# - Do not enable both SMTP_TLS and SMTP_SSL at the same time.
SMTP_TLS=true
SMTP_SSL=false

# ─── MEDIA ────────────────────────────────────────────────────────────────
# Максимальный размер загружаемого изображения в МБ (jpeg / png / webp).
# Допустимые форматы: JPEG, PNG, WebP (GIF не принимается).
# Изображения автоматически ресайзятся до 1920px и оптимизируются в WebP.
# Frontend читает это значение через GET /api/public/config — отдельная
# REACT_APP_* переменная не нужна.
NEWS_IMAGE_MAX_SIZE_MB=20
# ВАЖНО для деплоя с nginx — добавьте в server-блок:
#   client_max_body_size <NEWS_IMAGE_MAX_SIZE_MB + 5>M;
#   Пример: NEWS_IMAGE_MAX_SIZE_MB=30 → client_max_body_size 35M;

# ─── CHAT FILES ───────────────────────────────────────────────────────────
# Максимальный размер одного файла-вложения в МБ.
CHAT_FILE_MAX_SIZE_MB=20
# Максимальное количество файлов в одном сообщении.
CHAT_FILE_MAX_FILES_PER_MESSAGE=5
# Путь к private-хранилищу файлов чата (относительно mindcare_api/).
# ВАЖНО: этот путь НЕ должен обслуживаться Nginx/StaticFiles напрямую.
# Доступ только через download endpoint с проверкой прав (Stage 32c).
CHAT_FILE_STORAGE_DIR=storage/private/chat_attachments
# Бэкенд хранилища: 'local_private' — локальная FS (MVP).
CHAT_FILE_STORAGE_BACKEND=local_private

# ─── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Production example: ALLOWED_ORIGINS=https://mindcare.example.com
ALLOWED_ORIGINS=http://localhost:3000,https://mindcare.donru.edu.ru

# ─── SOCIAL AUTH (Stage Social Auth 2B; не секреты) ───────────────────────
# База redirect_uri провайдера: {base}/api/auth/oauth/{provider}/callback.
# Dev — напрямую backend :8000 (CRA-прокси не проксирует навигацию браузера).
# https:// включает Secure у state-cookie. Не смешивать localhost и 127.0.0.1.
# Допустимо только https:// или http:// на localhost — иначе провайдеры не
# регистрируются (MindCare при этом стартует).
OAUTH_CALLBACK_BASE_URL=http://localhost:8000
# Фиксированная страница фронтенда после callback (результат — во fragment).
OAUTH_FRONTEND_CALLBACK_URL=http://localhost:3000/auth/callback

# ─── YANDEX ID (Stage Social Auth 3A) ─────────────────────────────────────
# Вход через Яндекс ID по УЖЕ привязанной identity (регистрации через Яндекс
# пока нет). Выключено по умолчанию; при неполной конфигурации адаптер не
# регистрируется (/api/auth/oauth/yandex/* → 404), MindCare стартует как обычно.
#
# ClientID — из приложения Яндекс OAuth ЭТОГО окружения (DEV и PROD — разные
# приложения с разными Redirect URI). Redirect URI приложения должен ТОЧНО
# совпадать с {OAUTH_CALLBACK_BASE_URL}/api/auth/oauth/yandex/callback.
# Права приложения: «Адрес электронной почты» (login:email).
# client_secret НЕ используется и сюда НЕ добавляется (PKCE S256 + code_verifier).
# Реальный ClientID в git не коммитить.
YANDEX_OAUTH_ENABLED=false
YANDEX_OAUTH_CLIENT_ID=

# ─── ENCRYPTION ──────────────────────────────────────────────────────────────
# Ключ для шифрования чувствительных данных (session_notes.content,
# chat_messages.content, system messages).
# Алгоритм: Fernet (AES-128-CBC + HMAC-SHA256), authenticated encryption.
#
# Backend выполняет fail-fast проверку при старте: если ключ отсутствует или
# невалиден для Fernet, приложение НЕ запустится (assert_encryption_ready).
#
# Сгенерировать новый ключ:
# cd D:\mindcare\mindcare_api
# .\.venv\Scripts\python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ИЛИ
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Формат: 44 символа, URL-safe base64.
#
# ОБЯЗАТЕЛЬНО задать в production.
# НИКОГДА не коммитить реальный ключ в git.
# Хранить резервную копию ключа отдельно от резервной копии БД.
# Потеря ключа = необратимая потеря всех зашифрованных заметок сессий.
DATA_ENCRYPTION_KEY=

# ─── APP ──────────────────────────────────────────────────────────────────
# Environment name: development, staging, production, release.
# Do not put environment names into DEBUG.
ENV=development

# Boolean only: true/false, 1/0, yes/no, on/off.
# Do not use values like "release", "development", or "production" here.
# Production/staging servers should use DEBUG=false.
DEBUG=false
